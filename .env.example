FMC_URL=https://fmc.example.local
FMC_USER=api-user
FMC_PASSWORD=change-me

# Mount a private CA into the container with a Compose override, then set:
# FMC_CA_BUNDLE=/certs/fmc-ca.crt
FMC_TLS_VERIFY=true
FMC_TLS_VERIFY_HOSTNAME=true
FMC_TRUST_ENV=false

HTTP_PORT=8080
EXPORTER_PORT=8081
UPDATE_INTERVAL=60
CONNECT_TIMEOUT=5
READ_TIMEOUT=30

# Optional atomic JSON snapshot, e.g. /data/fmc.json after mounting /data.
OUTPUT_FILE=
